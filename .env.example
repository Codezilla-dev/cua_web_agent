# Copy to .env and fill in. .env is gitignored.

# --- LLM access ---
# The planner speaks OpenAI-compatible /chat/completions. Set ONE provider.
# The model must support forced tool calls. No default model id: a hardcoded
# slug goes stale and 404s mid-run.

# OpenAI:
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1   # only for Azure / a proxy

# OpenRouter (OpenAI-compatible gateway):
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=
# Comma-separated, max 2. OpenRouter retries these on the same request when the
# primary 429s. Not sent to OpenAI.
# OPENROUTER_FALLBACK_MODELS=

# Only if both keys are set.
# LLM_PROVIDER=openai

# --- Target surface ---
# target_app's own login, shown on its sign-in page. Redacted from every trace.
TARGET_URL=http://localhost:5000
TARGET_USERNAME=operator
TARGET_PASSWORD=vault-echo-77-quill

# --- Run behaviour ---
CUA_HEADED=1          # 1 = show the browser window, 0 = headless
CUA_MAX_STEPS=20
CUA_MAX_SECONDS=180
